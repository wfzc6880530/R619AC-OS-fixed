# ============================================================
# OpenWrt 25.12 编译配置
# 目标设备: P&W R619AC 128M（竞斗云 2.0 128M NAND 版）
# 设备名  : p2w_r619ac-128m (target: ipq40xx / subtarget: generic)
# 硬件    : IPQ4019 四核 717MHz / 512MB RAM / 16MB NOR + 128MB NAND
# 软件源  : 官方 feeds + kenzok8/small (PassWall/SSR-Plus)
#           + djylb/nps-openwrt (NPC 内网穿透客户端)
# 说明    : 在源码目录执行 make defconfig 后会自动补全其余选项
# ============================================================

# ---------- 目标平台 ----------
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_p2w_r619ac-128m=y

# ---------- 根文件系统 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---------- LuCI 管理界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-ssl=y

# ---------- DNS（PassWall / SSR-Plus 均依赖 dnsmasq-full，替换默认 dnsmasq） ----------
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

# ---------- 基础工具 ----------
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssl-util=y

# ---------- PassWall（代理管理面板，含 Xray 内核与 GeoIP/GeoSite 数据） ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y

# ---------- SSR-Plus（支持 SSR / SS / V2Ray / Trojan 等，勾选 SSR 与 Xray） ----------
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_GeoData=y

# ---------- NPC（nps 内网穿透客户端 + LuCI 管理界面） ----------
CONFIG_PACKAGE_npc=y
CONFIG_PACKAGE_luci-app-npc=y
